{
  "version": 2,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/index.py?__path__=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path__=/openapi.json"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path__=/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path__=/$1"
    }
  ]
}
