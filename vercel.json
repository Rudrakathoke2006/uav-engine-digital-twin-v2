{
  "version": 2,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/showcase",
      "destination": "/showcase/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
